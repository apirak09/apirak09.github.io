      "description": "Native switch role inside a divided explanatory setting row.",
      "html": "<label class=\"ds-setting\"><span><strong>Reduce motion</strong><small>Less decorative movement, no flashes or shake</small></span><input type=\"checkbox\" role=\"switch\"></label>",
      "css": ".ds-setting{font-family:Manrope,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:19px 0;border-bottom:1px solid var(--line,#afc2bc38);color:var(--ink,#f3f3dc)}.ds-setting>span{display:flex;flex-direction:column;gap:6px}.ds-setting strong{font-size:13px;font-weight:750}.ds-setting small{font-size:12px;color:var(--muted,#b4c1bc);line-height:1.6;max-width:250px}.ds-setting input{width:40px;height:28px;flex-shrink:0;cursor:pointer;accent-color:var(--accent,#e9edaa)}.ds-setting input:focus-visible{outline:3px solid var(--accent,#e9edaa);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}"
    },
