  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared launch, resume, and retry action; mode tokens inherit through the host.",
      "html": "<button class=\"ds-primary\"><span>Launch on the Moon</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:Manrope,sans-serif;background:var(--accent,#e9edaa);color:var(--on-accent,#172020);border:1px solid var(--accent,#e9edaa);border-radius:6px;min-height:54px;padding:15px 21px;font-size:15px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:18px;cursor:pointer;transition:background .2s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1)),box-shadow .2s;box-shadow:0 7px 22px #00000029}.ds-primary:hover{background:var(--ink,#f3f3dc);transform:translateY(-2px);box-shadow:0 9px 24px #00000040}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:3px solid var(--accent,#e9edaa);outline-offset:5px}.ds-primary:disabled{opacity:.55;cursor:wait}.ds-primary svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}"
    },
    {
