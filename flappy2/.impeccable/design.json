      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Return to world selection or close settings.",
      "html": "<button class=\"ds-secondary\">Choose another world</button>",
      "css": ".ds-secondary{font-family:Manrope,sans-serif;background:transparent;color:var(--ink,#f3f3dc);border:1px solid var(--line,#afc2bc38);border-radius:6px;min-height:48px;padding:12px 20px;font-size:12px;font-weight:650;display:block;width:100%;margin-top:12px;cursor:pointer;transition:background .15s}.ds-secondary:hover{background:#e5e2ce0a}.ds-secondary:focus-visible{outline:3px solid var(--accent,#e9edaa);outline-offset:5px}@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}"
    },
